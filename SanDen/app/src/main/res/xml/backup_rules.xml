<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Vault files and the database are excluded from cloud and device-to-device backups
    to prevent sensitive user data from leaking through backup channels.
-->
<data-extraction-rules>

    <cloud-backup>
        <!-- Exclude vault files stored in internal storage -->
        <exclude
            domain="file"
            path="vault/" />
        <!-- Exclude the Room database -->
        <exclude
            domain="database"
            path="sanden_vault.db" />
        <!-- Exclude shared preferences that may contain sensitive config -->
        <exclude
            domain="sharedpref"
            path="sanden_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Exclude vault files from device-to-device transfer -->
        <exclude
            domain="file"
            path="vault/" />
        <exclude
            domain="database"
            path="sanden_vault.db" />
    </device-transfer>

</data-extraction-rules>
